{
	"name": "mdat-plugin-cli-help",
	"version": "3.0.2",
	"description": "Mdat plugin to generate tabular help documentation for CLI tools in Markdown files.",
	"keywords": [
		"markdown",
		"mdat-plugin",
		"mdat",
		"cli",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/mdat-plugin-cli-help",
	"bugs": "https://github.com/kitschpatrol/mdat-plugin-cli-help/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/mdat-plugin-cli-help.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"bench": "vitest bench --run --no-file-parallelism --compare test/benchmarks/baseline.json",
		"bench:baseline": "vitest bench --run --no-file-parallelism --outputJson test/benchmarks/baseline.json",
		"build": "tsdown --no-fixed-extension --tsconfig tsconfig.build.json",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
		"test": "vitest run --no-file-parallelism"
	},
	"dependencies": {
		"@types/which": "^3.0.4",
		"chevrotain": "^13.0.0",
		"execa": "^10.0.1",
		"lognow": "^0.8.0",
		"type-fest": "^5.8.0",
		"which": "^7.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.5.0",
		"@types/node": "~24.13.3",
		"@types/yargs": "^17.0.35",
		"bumpp": "^12.1.1",
		"commander": "^15.0.0",
		"mdat": "^3.0.0",
		"meow": "^14.1.0",
		"shx": "^0.4.0",
		"tsdown": "^0.22.14",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10",
		"yargs": "^18.1.0"
	},
	"peerDependencies": {
		"mdat": "^3.0.0"
	},
	"packageManager": "pnpm@11.5.3",
	"engines": {
		"node": ">=24.16.0"
	}
}
