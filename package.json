{
	"name": "mdat-plugin-cli-help",
	"version": "3.4.2",
	"description": "Mdat plugin to generate tabular help documentation for CLI tools in Markdown files.",
	"keywords": [
		"markdown",
		"mdat-plugin",
		"mdat",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/mdat-plugin-cli-help",
	"bugs": "https://github.com/kitschpatrol/mdat-plugin-cli-help/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/mdat-plugin-cli-help.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"bench": "vitest bench --run --no-file-parallelism --reporter=verbose",
		"bench:baseline": "BENCH_BASELINE=true vitest bench --run --no-file-parallelism",
		"build": "tsdown --no-fixed-extension --tsconfig tsconfig.build.json",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "pnpm build && ksc fix",
		"lint": "pnpm build && ksc lint",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run --no-file-parallelism"
	},
	"dependencies": {
		"@types/which": "^3.0.4",
		"chevrotain": "^13.2.0",
		"execa": "^10.2.1",
		"lognow": "^0.8.7",
		"which": "^7.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@kitschpatrol/chagent": "0.4.0",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~24.13.6",
		"@types/yargs": "^17.0.35",
		"bumpp": "^12.3.0",
		"commander": "^15.0.0",
		"mdat": "^3.6.6",
		"meow": "^14.1.0",
		"shx": "^0.4.0",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.0.5",
		"yargs": "^18.2.0"
	},
	"peerDependencies": {
		"mdat": "^3.0.0"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
